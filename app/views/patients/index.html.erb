<!-- app/views/patients/index.html.erb -->
<div class="container mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold mb-6">Patients</h1>
  
  <%= turbo_frame_tag "patients_list" do %>
    <div class="bg-white rounded-lg shadow">
      <table class="min-w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left">Name</th>
            <th class="px-6 py-3 text-left">DOB</th>
            <th class="px-6 py-3 text-left">MRN</th>
            <th class="px-6 py-3 text-left">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @patients.each do |patient| %>
            <tr class="border-b hover:bg-gray-50">
              <td class="px-6 py-4"><%= patient.first_name %> <%= patient.last_name %></td>
              <td class="px-6 py-4"><%= patient.date_of_birth&.strftime("%m/%d/%Y") %></td>
              <td class="px-6 py-4"><%= patient.medical_record_number %></td>
              <td class="px-6 py-4">
                <%= link_to "View", patient_path(patient), class: "text-blue-600 hover:text-blue-900", data: { turbo_frame: "_top" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
